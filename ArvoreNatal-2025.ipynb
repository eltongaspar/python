        "import random\n",
        "import time\n",
        "import math # Necessário para a animação do foguete\n",
        "from IPython.display import display, HTML, Javascript, clear_output\n",
        "\n",
        "# --- Funções de Cor (Consolidada) ---\n",
        "def cor_aleatoria_hsl():\n",
        "    \"\"\"Gera uma cor HSL aleatória vibrante.\"\"\"\n",
        "    h = random.randint(0, 360)\n",
        "    s = random.randint(70, 100) # Alta saturação para cores vibrantes\n",
        "    l = random.randint(50, 70)  # Luminosidade média\n",
        "    return f\"hsl({h} {s}% {l}%)\"\n",
        "\n",
        "\n",
        "# --- Animação 1: Árvore de Natal (Originalmente cell_id: 121223c6) ---\n",
        "def gerar_arvore_html(altura=12):\n",
        "    \"\"\"Gera o HTML para uma árvore de natal colorida.\"\"\"\n",
        "    largura_total = altura * 2 + 1\n",
        "    linhas_html = []\n",
        "\n",
        "    # FOLHAS\n",
        "    for i in range(altura):\n",
        "        stars = \"\"\n",
        "        for _ in range(2 * i + 1):\n",
        "            stars += f'<span style=\"color:{cor_aleatoria_hsl()};\">*</span>'\n",
        "\n",
        "        # numero certo de espaços à esquerda\n",
        "        espacos = \" \" * (altura - i - 1)\n",
        "        linhas_html.append(espacos + stars)\n",
        "\n",
        "    # TRONCO — sempre centralizado\n",
        "    tronco_texto = \"||\"\n",
        "    espacos_tronco = \" \" * (altura - 1)\n",
        "\n",
        "    for _ in range(2):\n",
        "        linhas_html.append(espacos_tronco + f'<span style=\"color:{cor_aleatoria_hsl()};\">{tronco_texto}</span>')\n",
        "\n",
        "    # gerar bloco centralizado\n",
        "    conteudo = \"\\n\".join(linhas_html)\n",
        "\n",
        "    html = f'''\n",
        "    <div style=\"width:100%; display:flex; justify-content:center;\">\n",
        "      <pre style=\"display:inline-block; text-align:left; font-family: monospace;\n",
        "                  font-size:14px; line-height:1; white-space:pre;\">\n",
        "{conteudo}\n",
        "      </pre>\n",
        "    </div>\n",
        "    '''\n",
        "    return html\n",
        "\n",
        "def run_christmas_tree_animation(duration_seconds=15):\n",
        "    \"\"\"Executa a animação da árvore de natal por um tempo limitado.\"\"\"\n",
        "    print(\"\\n--- Iniciando Animação da Árvore de Natal ---\")\n",
        "    start_time = time.time()\n",
        "    try:\n",
        "        while time.time() - start_time < duration_seconds:\n",
        "            clear_output(wait=True)\n",
        "            display(HTML(gerar_arvore_html(12)))\n",
        "            display(Javascript(\"window.scrollTo(0, document.body.scrollHeight);\"))\n",
        "            time.sleep(0.25)\n",
        "    except KeyboardInterrupt:\n",
        "        print(\"Animação da Árvore de Natal interrompida.\")\n",
        "    finally:\n",
        "        clear_output()\n",
        "        print(\"--- Animação da Árvore de Natal Finalizada ---\")\n",
        "\n",
        "\n",
        "# --- Animação 2: Fogos de Artifício de Ano Novo (Originalmente cell_id: BUHpZ2Zspnwv) ---\n",
        "def gerar_fogo_artificio():\n",
        "    \"\"\"Cria uma string HTML que representa um fogo de artifício.\"\"\"\n",
        "    largura = random.randint(4, 12)\n",
        "    altura = random.randint(3, 6)\n",
        "    espacos = random.randint(0, 12)\n",
        "\n",
        "    fogo_html = []\n",
        "    for i in range(altura):\n",
        "        linha = \"&nbsp;\" * espacos\n",
        "        for _ in range(largura):\n",
        "            linha += f'<span style=\"color:{cor_aleatoria_hsl()}; font-weight: bold;\">*</span>'\n",
        "        fogo_html.append(linha)\n",
        "        espacos = max(0, espacos - 1)\n",
        "\n",
        "    return \"<br>\".join(fogo_html)\n",
        "\n",
        "def texto_colorido(txt):\n",
        "    \"\"\"Transforma um texto em HTML com cada letra colorida aleatoriamente.\"\"\"\n",
        "    html = \"\"\n",
        "    for letra in txt:\n",
        "        cor = cor_aleatoria_hsl()\n",
        "        html += f'<span style=\"color:{cor}; font-size:28px; font-weight:bold;\">{letra}</span>'\n",
        "    return html\n",
        "\n",
        "def contagem_regressiva(segundos=5):\n",
        "    \"\"\"Exibe uma contagem regressiva.\"\"\"\n",
        "    for i in range(segundos, 0, -1):\n",
        "        clear_output(wait=True)\n",
        "        display(HTML(f\"\"\"\n",
        "        <div style=\"text-align:center; font-size:60px; font-weight:bold; color:{cor_aleatoria_hsl()};\">\n",
        "            {i}\n",
        "        </div>\n",
        "        \"\"\"))\n",
        "        time.sleep(1)\n",
        "\n",
        "def run_new_year_fireworks_animation(message_duration_seconds=9, fireworks_duration_seconds=15):\n",
        "    \"\"\"Executa a animação de fogos de artifício de ano novo por um tempo limitado.\"\"\"\n",
        "    print(\"\\n--- Iniciando Animação de Fogos de Artifício de Ano Novo ---\")\n",
        "    try:\n",
        "        # CONTAGEM REGRESSIVA\n",
        "        contagem_regressiva(5)\n",
        "\n",
        "        # MENSAGEM \"FELIZ ANO NOVO!\"\n",
        "        start_message_time = time.time()\n",
        "        while time.time() - start_message_time < message_duration_seconds:\n",
        "            clear_output(wait=True)\n",
        "            mensagem = texto_colorido(\"🎉 FELIZ ANO NOVO! 🎉\")\n",
        "            fogo = gerar_fogo_artificio() + \"<br>\" + gerar_fogo_artificio()\n",
        "\n",
        "            display(HTML(f\"\"\"\n",
        "            <div style=\"text-align:center;\">\n",
        "                <div style=\"margin-bottom:20px;\">{mensagem}</div>\n",
        "                <pre style=\"font-family: monospace; font-size: 18px; line-height: 1; white-space: pre-wrap;\">\n",
        "{fogo}\n",
        "                </pre>\n",
        "            </div>\n",
        "            \"\"\"))\n",
        "            time.sleep(0.6)\n",
        "\n",
        "        # LOOP DE FOGOS (agora limitado)\n",
        "        start_fireworks_time = time.time()\n",
        "        while time.time() - start_fireworks_time < fireworks_duration_seconds:\n",
        "            clear_output(wait=True)\n",
        "            fogo = gerar_fogo_artificio()\n",
        "            display(HTML(f'<pre style=\"font-family: monospace; font-size: 18px; white-space: pre-wrap;\">{fogo}</pre>'))\n",
        "            display(Javascript(\"window.scrollTo(0, document.body.scrollHeight);\"))\n",
        "            time.sleep(0.5)\n",
        "\n",
        "    except KeyboardInterrupt:\n",
        "        print(\"Animação de Fogos de Artifício de Ano Novo interrompida.\")\n",
        "    finally:\n",
        "        clear_output()\n",
        "        print(\"--- Animação de Fogos de Artifício de Ano Novo Finalizada ---\")\n",
        "\n",
        "\n",
        "# --- Animação 3: Foguetes e Explosões (Originalmente cell_id: tLuSSYcuqxk-) ---\n",
        "def criar_tela(larg=70, alt=25):\n",
        "    \"\"\"Cria uma matriz vazia para a 'tela' da animação.\"\"\"\n",
        "    return [[\" \" for _ in range(larg)] for _ in range(alt)]\n",
        "\n",
        "def tela_para_html(tela):\n",
        "    \"\"\"Converte a matriz da tela em HTML colorido.\"\"\"\n",
        "    html = \"<pre style='font-family: monospace; font-size:16px; line-height:1;'>\"\n",
        "    for linha in tela:\n",
        "        for celula in linha:\n",
        "            if isinstance(celula, tuple):\n",
        "                char, c = celula\n",
        "                html += f\"<span style='color:{c}; font-weight:bold;'>{char}</span>\"\n",
        "            else:\n",
        "                html += celula\n",
        "        html += \"\\n\"\n",
        "    html += \"</pre>\"\n",
        "    return html\n",
        "\n",
        "def animar_subida(tela_dummy, x, frames=8): # 'tela_dummy' is not used, consistent with original\n",
        "    \"\"\"Anima o foguete subindo.\"\"\"\n",
        "    for i in range(frames):\n",
        "        clear_output(wait=True)\n",
        "        tela_temp = criar_tela()\n",
        "\n",
        "        y = len(tela_temp) - 2 - i\n",
        "        if 0 <= y < len(tela_temp):\n",
        "            tela_temp[y][x] = (\"|\", cor_aleatoria_hsl()) # Usando cor_aleatoria_hsl\n",
        "\n",
        "        display(HTML(tela_para_html(tela_temp)))\n",
        "        time.sleep(0.08)\n",
        "\n",
        "def animar_explosao(x, y):\n",
        "    \"\"\"Anima a explosão circular de um foguete.\"\"\"\n",
        "    particulas = []\n",
        "\n",
        "    for _ in range(35):\n",
        "        ang = random.uniform(0, 6.28) # 2*PI\n",
        "        vel = random.uniform(0.5, 1.8)\n",
        "        particulas.append({\n",
        "            \"x\": x,\n",
        "            \"y\": y,\n",
        "            \"dx\": vel * math.cos(ang),\n",
        "            \"dy\": vel * math.sin(ang),\n",
        "            \"cor\": cor_aleatoria_hsl() # Usando cor_aleatoria_hsl\n",
        "        })\n",
        "\n",
        "    # anima os fragmentos\n",
        "    for frame in range(10):\n",
        "        tela_temp = criar_tela()\n",
        "        clear_output(wait=True)\n",
        "\n",
        "        for p in particulas:\n",
        "            p[\"x\"] += p[\"dx\"]\n",
        "            p[\"y\"] += p[\"dy\"]\n",
        "            p[\"dy\"] += 0.1  # gravidade\n",
        "\n",
        "            xi, yi = int(p[\"x\"]), int(p[\"y\"])\n",
        "            if 0 <= yi < len(tela_temp) and 0 <= xi < len(tela_temp[0]):\n",
        "                tela_temp[yi][xi] = (\"*\", p[\"cor\"])\n",
        "\n",
        "        display(HTML(tela_para_html(tela_temp)))\n",
        "        time.sleep(0.09)\n",
        "\n",
        "def run_rocket_fireworks_animation(duration_seconds=20):\n",
        "    \"\"\"Executa a animação de foguetes e explosões por um tempo limitado.\"\"\"\n",
        "    print(\"\\n--- Iniciando Animação de Foguetes e Explosões ---\")\n",
        "    start_time = time.time()\n",
        "    try:\n",
        "        while time.time() - start_time < duration_seconds:\n",
        "            # escolher posição aleatória para o foguete\n",
        "            x = random.randint(10, 60)\n",
        "\n",
        "            # anima subida\n",
        "            animar_subida(None, x, frames=random.randint(5, 9))\n",
        "\n",
        "            # ponto da explosão\n",
        "            y_explosao = random.randint(6, 12)\n",
        "\n",
        "            # anima explosão\n",
        "            animar_explosao(x, y_explosao)\n",
        "\n",
        "    except KeyboardInterrupt:\n",
        "        print(\"Animação de Foguetes e Explosões interrompida.\")\n",
        "    finally:\n",
        "        clear_output()\n",
        "        print(\"--- Animação de Foguetes e Explosões Finalizada ---\")\n",
        "\n",
        "\n",
        "# ==================================\n",
        "#     Execução Sequencial das Animações\n",
        "# ==================================\n",
        "\n",
        "# Chamar as animações em sequência\n",
        "# Cada uma será executada por um tempo definido ou até ser interrompida.\n",
        "run_christmas_tree_animation(duration_seconds=15) # Animação da árvore por 15 segundos\n",
        "time.sleep(3) # Pequena pausa entre as animações\n",
        "\n",
        "run_new_year_fireworks_animation(message_duration_seconds=9, fireworks_duration_seconds=15) # Ano Novo por 9s de mensagem + 15s de fogos\n",
