        "\n",
        "run_rocket_fireworks_animation(duration_seconds=25) # Foguetes por 25 segundos\n",
        "\n",
        "print(\"\\nTodas as animações foram executadas. Clique no botão de interrupção (quadrado) para parar a execução a qualquer momento.\")\n"
