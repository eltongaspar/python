        "import random\n",
        "import time\n",
        "from IPython.display import display, HTML, Javascript, clear_output\n",
        "\n",
        "# ---------- GERA CORES ----------\n",
        "def cor_aleatoria_hsl():\n",
        "    h = random.randint(0, 360)\n",
        "    s = random.randint(70, 100)\n",
        "    l = random.randint(50, 70)\n",
        "    return f\"hsl({h} {s}% {l}%)\"\n",
        "\n",
        "# ---------- CRIA UM FOGO DE ARTIFÍCIO ----------\n",
        "def gerar_fogo_artificio():\n",
        "    largura = random.randint(4, 12)\n",
        "    altura = random.randint(3, 6)\n",
        "    espacos = random.randint(0, 12)\n",
        "\n",
        "    fogo_html = []\n",
        "    for i in range(altura):\n",
        "        linha = \"&nbsp;\" * espacos\n",
        "        for _ in range(largura):\n",
        "            linha += f'<span style=\"color:{cor_aleatoria_hsl()}; font-weight: bold;\">*</span>'\n",
        "        fogo_html.append(linha)\n",
        "        espacos = max(0, espacos - 1)\n",
        "\n",
        "    return \"<br>\".join(fogo_html)\n",
        "\n",
        "# ---------- TEXTO COM EFEITO COLORIDO ----------\n",
        "def texto_colorido(txt):\n",
        "    html = \"\"\n",
        "    for letra in txt:\n",
        "        cor = cor_aleatoria_hsl()\n",
        "        html += f'<span style=\"color:{cor}; font-size:28px; font-weight:bold;\">{letra}</span>'\n",
        "    return html\n",
